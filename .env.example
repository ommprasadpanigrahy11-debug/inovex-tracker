# ==============================================================================
# INOVEX TRACKER - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or configure these variables in your hosting environment
# (e.g., Vercel, Railway, Render, Fly.io, or VPS).

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Node.js Express + WebSockets)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production

# The allowed origin for CORS (e.g., your Vercel deployment URL)
ALLOWED_ORIGIN=https://your-inovex-app.vercel.app

# Founder Registration Bootstrap Secret
# This token is required ONLY when registering the very first Founder account
# or creating new founder accounts without an existing founder session.
# Keep this secret safe! Do not share it publicly.
INITIAL_FOUNDER_KEY=generate_a_random_32_character_hex_secret_here

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Base URL for backend API requests (leave empty if frontend and backend share origin)
VITE_API_URL=https://api.yourdomain.com

# Base URL for WebSocket subscriptions (leave empty if matching window.location.origin)
VITE_WS_URL=wss://api.yourdomain.com

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD DATABASE & RESTRICTED STORAGE (Optional Cloud Layer)
# ------------------------------------------------------------------------------
# Obtain from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

