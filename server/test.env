# Test-only environment (loaded via `node --env-file`).
# Runs the suite against a throwaway, seeded database so the real/dev database
# stays a clean slate. SEED_DEMO_DATA is honored only outside production.
NODE_ENV=test
SEED_DEMO_DATA=true
DB_PATH=server/data/test-antigravity.db
INITIAL_FOUNDER_KEY=inovex_test_bootstrap_secret_high_entropy_2026
ALLOWED_ORIGIN=https://inovex-production-app.vercel.app
